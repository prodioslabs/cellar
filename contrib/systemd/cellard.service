[Unit]
Description=Cellar node daemon
Documentation=https://github.com/prodioslabs/cellar
After=network-online.target systemd-sysusers.service
Wants=network-online.target

[Service]
Type=simple
User=cellar
Group=cellar
SupplementaryGroups=kvm
StateDirectory=cellar
RuntimeDirectory=cellar
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/cellard
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45

# Hardening (compatible with microsandbox / KVM)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cellar /run/cellar
DeviceAllow=/dev/kvm rw
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
