{
  "name": "@cellar/node",
  "version": "0.1.0",
  "description": "TypeScript SDK for Cellar SandboxAPI (Node.js and Bun)",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "proto": "mkdir -p src/gen && protoc -I ../../api/proto --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=esModuleInterop=true --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=env=node --ts_proto_opt=useExactTypes=false --ts_proto_opt=exportCommonSymbols=false sandbox.proto",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build",
    "lint": "oxlint --fix --fix-suggestions",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.13.4",
    "long": "^5.3.2",
    "protobufjs": "^7.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "ts-proto": "^2.7.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=18"
  }
}
